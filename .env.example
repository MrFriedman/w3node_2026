# HowlPay — Sepolia testnet only.
# Copy this file to .env at the repo root. .env is gitignored.
# Never put a real seed, private key, or mainnet RPC in this project.
# The display name lives in shared/brand.ts.

# BIP-39 seed for the wallet this process should open.
# Shop demo: the shop's testnet seed. Reward payout: the platform treasury seed.
# Generate one locally. Do not paste it into chat, commits, or screenshots.
# A public BIP-39 test vector (empty wallet) is listed in Tether's examples:
# https://github.com/tetherto/wdk-examples/blob/main/.env.example
WDK_SEED_PHRASE=

# Ethereum Sepolia. Chain id is fixed at 11155111 in the script.
# publicnode answered from this checkpoint environment. drpc is the URL in
# Tether's Node quickstart; switch if your network blocks one of them.
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Test Tether USD (symbol USDT, 6 decimals) on Sepolia.
# This is the contract in Tether's wdk-examples .env.example.
# The React Native starter instead uses 0xd077A400968890Eacc75cdc901F0356c943e4fDb
# (on-chain name "Tether USD", symbol USD₮, also 6 decimals, also Sepolia).
EVM_TOKEN_CONTRACT=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06

# Where shop top-ups are paid. Required for --bundle unless you pass --to.
PLATFORM_TREASURY_ADDRESS=

# Checkpoint FX snapshot, not a live quote.
# Frankfurter, 11 Nov 2026: 1 USD = 16.5639 ZAR. 1 USDT is treated as 1 USD.
ZAR_PER_USDT=16.5639
